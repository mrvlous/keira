# System Utilities Kbuild Manifest
#
# Declares POSIX system administration and identity utilities.

# Standalone system administration and identity utilities
bin-y		+= df \
		   dmesg \
		   hostname \
		   id \
		   mount \
		   sleep \
		   su \
		   umount \
		   uname \
		   whoami

# Multi-source system metrics and hardware introspection utility
multi-bin-y	+= sysinfo
