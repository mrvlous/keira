# Core Utilities Kbuild Manifest
#
# Declares standard standalone POSIX core utility binaries.

bin-y		+= cat \
		   chmod \
		   chown \
		   clear \
		   echo \
		   grep \
		   head \
		   ln \
		   ls \
		   mkdir \
		   rm \
		   tail \
		   touch \
		   wc
