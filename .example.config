#
# Keira Kernel Default Configuration Template
# This file serves as an example configuration template for the Keira
# freestanding operating system. To customize your build, copy this file
# to `.config` in the repository root or execute `make defconfig`:
#
#   cp .example.config .config
#

#
# Architecture Configuration
#
# Select target instruction set architecture.
# Choose either x86_64 (64-bit Long Mode) or i686 (32-bit Protected Mode).
CONFIG_ARCH_X86_64=y
# CONFIG_ARCH_I686 is not set

#
# Privilege Separation & Userland Subsystem
#
# CONFIG_USERLAND: Controls whether Ring 3 C userland runtime (libc.a, crt0.o)
# and all 30 core utility binaries are built and bundled into initrd and rootfs.
#   y: Full monolithic OS with POSIX userland shell, binaries and C compiler.
#   n: Pure freestanding Ring 0 kernel entering supervisor console directly.
CONFIG_USERLAND=y

#
# Symmetric Multiprocessing (SMP)
#
# Number of CPU cores configured for QEMU emulation and kernel scheduler.
CONFIG_SMP=2

#
# Storage & Disk Image Configuration
#
# Size of the virtual FAT16 disk image in megabytes (MB).
CONFIG_DISK_SIZE=32

#
# QEMU Emulation Parameters
#
# Virtual RAM allocation and CPU topology for QEMU boot targets.
CONFIG_QEMU_MEM=128M
CONFIG_QEMU_CPUS=2

#
# Build Verbosity
#
# Set to 1 to display complete compilation commands and compiler flags.
# Set to 0 for concise kernel build output.
CONFIG_VERBOSE=0
