# Scheduler & Task Concurrency Configuration
#
# Configures multi-core work-stealing scheduler queues, wait queues,
# deferred kernel workqueues and bare-metal io_uring asynchronous I/O engine.

menu "Scheduler & Task Concurrency"

config SCHED_WORK_STEALING
	bool "Multi-Core Work-Stealing Scheduling Algorithm"
	default y
	help
	  Enable work-stealing queues across symmetric multiprocessing cores
	  to balance thread execution loads.

config WAIT_QUEUES
	bool "Kernel Wait Queues & Sleep Synchronization"
	default y
	help
	  Enable Linux-grade kernel wait queue heads (wait_queue_head_t),
	  condition wakeups and event sleep synchronization.

config WORK_QUEUES
	bool "Kernel Workqueues & Deferred Execution (kworker)"
	default y
	depends on WAIT_QUEUES
	help
	  Enable Linux-grade kernel workqueues (work_struct and delayed_work)
	  with background Ring 0 [kworker/0:0] deferred callback execution.

config IO_URING
	bool "Asynchronous I/O Engine (io_uring)"
	default y
	help
	  High-performance kernel ring buffer completion queue architecture
	  for zero-syscall asynchronous operations.

endmenu
