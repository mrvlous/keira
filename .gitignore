# SPDX-License-Identifier: GPL-2.0-only

# Git Ignore Specification
#
# Configures paths and file patterns that should be untracked by Git.

# Rust compilation target directory
/target/

# Master and userland build system output directories
/build/
/userland/build/

# Compiled objects, libraries and binary artifacts
*.o
*.a
*.bin
!crates/io/src/vga/**/vga_font.bin
*.elf
*.iso
*.img
*.tar
*.d

# Documentation build and Sphinx artifacts
/docs/_build/
/docs/_static/
/docs/_templates/
/docs/.doctrees/

# Python virtual environment and bytecode caches
/.venv/
/venv/
/env/
__pycache__/
*.pyc
*.pyo

# Temporary editor files, swaps and backups
*~
*.swp
*.swo
*.bak
*.tmp
*.orig
*.rej
*.log
*.out
.DS_Store
Thumbs.db

# Local IDE and tooling configuration caches
.idea/
.vscode/
.vscode-test/
.clangd/
.eglot/
.cache/
.gdb_history

# Linux-style build configuration and exported UAPI headers
.config
.config.old
/include/uapi/
