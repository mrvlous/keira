# Git Ignore Specification
#
# Configures paths and file patterns that should be untracked by Git.

# Rust compilation target directory
/target/

# Master build system output directory
/build/

# Compiled objects and binary artifacts
*.o
*.a
*.bin
!crates/io/src/vga/vga_font.bin
*.elf
*.iso
*.img
*.d

# Temporary editor files, swaps, and backups
*~
*.swp
*.swo
*.bak
*.tmp
*.orig
*.rej
*.log
*.out
.DS_Store
Thumbs.db

# Python bytecode caches
__pycache__/
*.pyc

# Local IDE & tooling configuration caches
.idea/
.vscode/
.vscode-test/
.clangd/
.eglot/
.cache/
.gdb_history
