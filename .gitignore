# Git Ignore Specification
#
# Configures paths and file patterns that should be untracked by Git.

# Rust compilation target directory
/target/

# Master build system output directory
/build/

# Temporary editor files and backups
*~
*.swp
*.swo
.DS_Store

# Local IDE configuration caches
.idea/
.vscode/
.vscode-test/
.clangd/
.eglot/
