# i686 Protected Mode Architecture Kbuild Manifest
#
# Declares low-level assembly sources for 32-bit bootstrap, GDT, IDT and system calls.

# 32-bit Protected Mode bootstrap, GDT, IDT, ISR and syscall trampolines
asm-src-y	+= arch/x86/i686/boot/entry.asm \
		   arch/x86/i686/boot/ap_trampoline.asm \
		   arch/x86/i686/kernel/gdt.asm \
		   arch/x86/i686/kernel/idt.asm \
		   arch/x86/i686/kernel/isr.asm \
		   arch/x86/i686/kernel/syscall.asm
