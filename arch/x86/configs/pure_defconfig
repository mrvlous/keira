# Keira Kernel Configuration Baseline (Pure Ring 0)
#
# Baseline configuration profile for pure freestanding Ring 0 supervisor console.
#

#
# Processor Architecture & System Specifications
#
#
# Target CPU Architecture
#
CONFIG_ARCH_X86_64=y
# CONFIG_ARCH_I686 is not set
CONFIG_SMP=y
CONFIG_MAX_CPUS=2

#
# Kernel Core Subsystems & Features
#

#
# Memory Management & Protection
#
CONFIG_ASLR=y
CONFIG_W_XOR_X=y

#
# Scheduler & Task Concurrency
#
CONFIG_SCHED_WORK_STEALING=y
CONFIG_IO_URING=y

#
# Filesystems & Storage Subsystem
#
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y
CONFIG_FS_PROCFS=y

#
# Networking Subsystem & Device Drivers
#
CONFIG_NET_STACK=y
CONFIG_NET_E1000=y
CONFIG_NET_SOCKETS=y

#
# Security, Hardening & Isolation
#
CONFIG_RLIMIT=y
CONFIG_CRYPTO_ENTROPY=y

#
# Privilege Separation & Userland Subsystem
#
# CONFIG_USERLAND is not set

#
# Storage, Disk & Emulation Parameters
#
CONFIG_DISK_SIZE=32
CONFIG_QEMU_MEM="128M"
CONFIG_QEMU_CPUS=2
CONFIG_VERBOSE=0
