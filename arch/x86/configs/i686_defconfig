# Keira Kernel Configuration Baseline
#
# Automatically generated configuration profile for Keira Kernel.
#

#
# Processor Architecture & System Specifications
#
# CONFIG_ARCH_X86_64 is not set
CONFIG_ARCH_I686=y
CONFIG_SMP=y
CONFIG_MAX_CPUS=2

#
# Privilege Separation & Userland Subsystem
#
CONFIG_USERLAND=y

#
# Memory Management & Security
#
CONFIG_ASLR=y
CONFIG_W_XOR_X=y

#
# Storage, Disk & Emulation Parameters
#
CONFIG_DISK_SIZE=32
CONFIG_QEMU_MEM="128M"
CONFIG_QEMU_CPUS=2
CONFIG_VERBOSE=0
