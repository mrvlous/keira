# Clangd Language Server Configuration
#
# Provides compilation settings and header search paths for the Clangd LSP.
# This ensures code intelligence tools can resolve headers and provide correct
# diagnostics, code navigation and autocomplete in userland C files.

CompileFlags:
  Add:
    # User-space application and library header directories
    - "-Iinclude"
    - "-Iuserland/libc/include"
    # User-space binary internal header directories
    - "-Iuserland/toolchain/kcc/include"
    - "-Iuserland/sysutils/sysinfo/include"
    - "-Iuserland/tests/test_abi/include"
    - "-Iuserland/tests/fuzz_abi/include"
    - "-ffreestanding"
    - "-m64"
