# Clangd Language Server Configuration
#
# Provides compilation settings and header search paths for the Clangd LSP.
# This ensures code intelligence tools can resolve headers and provide correct
# diagnostics, code navigation, and autocomplete in userland C files.

CompileFlags:
  Add:
    # User-space application and library header directory
    - "-Iuser/include"
    # KCC C compiler internal header directory
    - "-Iuser/bin/kcc/include"
    - "-ffreestanding"
    - "-m64"
