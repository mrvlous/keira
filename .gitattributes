# Git Attributes Configuration
#
# Configures path-specific attributes such as line endings and merge strategies.

# Enforce Unix-style (LF) line endings for all text files
* text=auto eol=lf

# Explicitly mark source and configuration files as text
*.c text
*.h text
*.rs text
*.asm text
*.inc text
*.ld text
*.toml text
*.json text
*.md text
*.rst text
*.css text
*.js text
*.html text
*.sh text
*.py text
*.ini text
*.cfg text
Kconfig* text
Kbuild* text
*defconfig text
.pylintrc text
.editorconfig text
.clang-format text
.clangd text
.clippy.toml text
.gitignore text
.gitattributes text
rustfmt.toml text
rust-toolchain.toml text
*.yml text
*.yaml text
COPYING text
CREDITS text
MAINTAINERS text
README text
AGENTS.md text
Makefile text

# Mark executable and archive binary files as binary
*.bin binary
*.iso binary
*.img binary
*.qcow2 binary
*.png binary
*.a binary
*.o binary
*.elf binary
*.tar binary
*.pcap binary
*.ppm binary
*.dmp binary
