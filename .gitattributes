# Git Attributes Configuration
#
# Configures path-specific attributes such as line endings and merge strategies.

# Enforce Unix-style (LF) line endings for all text files
* text=auto eol=lf

# Explicitly mark source files as text
*.c text
*.h text
*.rs text
*.asm text
*.inc text
*.ld text
*.toml text
*.json text
*.md text
*.rst text
*.css text
*.js text
*.sh text
Makefile text

# Mark executable and archive binary files as binary
*.bin binary
*.iso binary
*.img binary
*.a binary
*.o binary
*.elf binary
*.tar binary
